{
  "name": "yds-vocabulary-spaced-repetition",
  "version": "1.0.0",
  "description": "YDS Vocabulary Spaced Repetition Mobile Application with SQLite and Leitner Box Engine",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --host lan",
    "dev": "expo start --host lan",
    "go": "expo start --go --host lan",
    "tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-apple-authentication": "~6.4.2",
    "expo-auth-session": "~5.5.2",
    "expo-build-properties": "~0.12.5",
    "expo-crypto": "~13.0.2",
    "expo-notifications": "~0.28.19",
    "expo-sqlite": "~14.0.0",
    "expo-web-browser": "~13.0.3",
    "lucide-react-native": "^1.32.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-purchases": "^10.8.1",
    "react-native-svg": "15.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~18.2.45",
    "babel-preset-expo": "~11.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.3.3"
  },
  "private": true
}

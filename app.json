{
  "expo": {
    "name": "YDS Pratik",
    "slug": "ydspratik",
    "scheme": "ydspratik",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4762BD"
    },
    "ios": {
      "bundleIdentifier": "com.celebi.ydspratik",
      "buildNumber": "1",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "CFBundleDisplayName": "YDS Pratik",
        "UIRequiresFullScreen": true
      }
    },
    "android": {
      "package": "com.celebi.ydspratik",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E40AF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
